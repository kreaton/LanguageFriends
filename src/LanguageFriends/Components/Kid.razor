@* A cute cartoon kid, drawn as SVG from a KidLook. The mood changes the face, raises the arms when happy,
   and picks the CSS animation (bob, talk, jump, shake). Everything is in a 200 × 220 box. *@

<svg class="kid kid-@Mood.ToString().ToLowerInvariant()" viewBox="0 0 200 220" role="img" aria-label="@Label">
    <defs>
        <clipPath id="@_id-body"><path d="@BodyPath" /></clipPath>
    </defs>

    <g class="kid-all">
        @* ---- Body: shirt, stripes, collar, and arms when happy ---- *@
        @if (Mood == Mood.Happy)
        {
            <g class="kid-arms">
                <path d="M52 182 Q30 160 26 122" stroke="@L.Shirt" stroke-width="20" stroke-linecap="round" fill="none" />
                <path d="M148 182 Q170 160 174 122" stroke="@L.Shirt" stroke-width="20" stroke-linecap="round" fill="none" />
                <circle cx="25" cy="114" r="12" fill="@L.Skin" />
                <circle cx="175" cy="114" r="12" fill="@L.Skin" />
            </g>
        }
        <path d="@BodyPath" fill="@L.Shirt" />
        @if (L.Stripes)
        {
            <g clip-path="url(#@_id-body)" fill="@L.Trim">
                @for (var y = 180; y < 220; y += 14)
                {
                    <rect x="0" y="@y" width="200" height="6" />
                }
            </g>
        }
        <path d="M30 220 C32 186 60 168 100 168 C140 168 168 186 170 220" fill="none" stroke="rgba(0,0,0,.08)" stroke-width="3" />

        @* ---- Hair behind the head ---- *@
        @BackHair

        @* ---- Neck, collar, ears, head ---- *@
        <rect x="86" y="140" width="28" height="32" rx="10" fill="@Shade" />
        <path d="M80 168 Q100 190 120 168" fill="none" stroke="@L.Trim" stroke-width="6" stroke-linecap="round" />
        <circle cx="49" cy="108" r="11" fill="@L.Skin" />
        <circle cx="151" cy="108" r="11" fill="@L.Skin" />
        <circle cx="50" cy="109" r="5" fill="@Shade" />
        <circle cx="150" cy="109" r="5" fill="@Shade" />
        <ellipse cx="100" cy="102" rx="52" ry="54" fill="@L.Skin" />

        @* ---- Hair on top ---- *@
        @FrontHair

        @* ---- Face ---- *@
        <ellipse cx="69" cy="128" rx="9" ry="5.5" fill="#ff8fa3" opacity=".45" />
        <ellipse cx="131" cy="128" rx="9" ry="5.5" fill="#ff8fa3" opacity=".45" />
        @if (L.Freckles)
        {
            <g fill="#c26d4a" opacity=".55">
                <circle cx="66" cy="120" r="1.6" /><circle cx="72" cy="123" r="1.6" /><circle cx="62" cy="125" r="1.6" />
                <circle cx="134" cy="120" r="1.6" /><circle cx="128" cy="123" r="1.6" /><circle cx="138" cy="125" r="1.6" />
            </g>
        }

        @* Brows *@
        @if (Mood == Mood.Oops)
        {
            <path d="M70 93 L87 89" stroke="@Brow" stroke-width="4" stroke-linecap="round" />
            <path d="M113 89 L130 93" stroke="@Brow" stroke-width="4" stroke-linecap="round" />
        }
        else
        {
            <path d="M71 92 Q79 86 87 90" fill="none" stroke="@Brow" stroke-width="4" stroke-linecap="round" />
            <path d="M113 90 Q121 86 129 92" fill="none" stroke="@Brow" stroke-width="4" stroke-linecap="round" />
        }

        @* Eyes *@
        @if (Mood == Mood.Happy)
        {
            <path d="M72 111 Q80 100 88 111" fill="none" stroke="#2b2340" stroke-width="4.5" stroke-linecap="round" />
            <path d="M112 111 Q120 100 128 111" fill="none" stroke="#2b2340" stroke-width="4.5" stroke-linecap="round" />
        }
        else
        {
            var ry = Mood == Mood.Oops ? 6.5 : 8.5;
            <g class="kid-eyes">
                <ellipse cx="80" cy="108" rx="6.5" ry="@ry" fill="#2b2340" />
                <ellipse cx="120" cy="108" rx="6.5" ry="@ry" fill="#2b2340" />
                <circle cx="82.5" cy="104.5" r="2.5" fill="#fff" />
                <circle cx="122.5" cy="104.5" r="2.5" fill="#fff" />
            </g>
        }

        <path d="M96 119 Q100 123 104 119" fill="none" stroke="@Shade" stroke-width="3" stroke-linecap="round" />

        @* Mouth *@
        @switch (Mood)
        {
            case Mood.Happy:
                <path d="M83 128 Q100 152 117 128 Z" fill="#7a2e3a" stroke="#7a2e3a" stroke-width="2" stroke-linejoin="round" />
                <path d="M91 139 Q100 147 109 139 Q100 134 91 139 Z" fill="#ff8787" />
                break;
            case Mood.Talk:
                <ellipse class="kid-mouth" cx="100" cy="134" rx="8" ry="6.5" fill="#7a2e3a" />
                break;
            case Mood.Oops:
                <path d="M88 138 Q94 132 100 138 Q106 144 112 138" fill="none" stroke="#7a2e3a" stroke-width="3.5" stroke-linecap="round" />
                break;
            default:
                <path d="M87 130 Q100 142 113 130" fill="none" stroke="#7a2e3a" stroke-width="3.5" stroke-linecap="round" />
                break;
        }

        @* ---- Accessories ---- *@
        @Extras
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public Language Language { get; set; } = default!;
    [Parameter] public Mood Mood { get; set; } = Mood.Idle;

    private readonly string _id = "k" + Guid.NewGuid().ToString("N")[..8];

    private KidLook L => Language.Look;
    private string Label => Language.KidName;

    private const string BodyPath = "M28 220 C30 184 58 166 100 166 C142 166 170 184 172 220 Z";

    // A darker skin tone for the neck, inner ears and nose; and a darker hair colour for the brows.
    private string Shade => Mix(L.Skin, "#8a4b2a", 0.22);
    private string Brow => Mix(L.Hair, "#2b1b12", 0.45);
    private string HairDark => Mix(L.Hair, "#000000", 0.18);

    // The swept fringe that most long-haired styles share.
    private const string SideFringe =
        "M47 110 C42 58 72 38 100 38 C130 38 158 58 153 110 C149 88 136 70 114 64 C102 80 78 86 56 90 C51 96 48 103 47 110 Z";

    private RenderFragment BackHair => __builder =>
    {
        switch (L.Style)
        {
            case HairStyle.Long:
                <path d="M46 100 C40 56 70 34 100 34 C130 34 160 56 154 100 L162 182 C146 196 54 196 38 182 Z" fill="@L.Hair" />
                break;
            case HairStyle.Bob:
                <path d="M45 104 C40 56 70 34 100 34 C130 34 160 56 155 104 L158 148 Q150 160 138 150 L62 150 Q50 160 42 148 Z" fill="@L.Hair" />
                break;
            case HairStyle.CurlyLong:
                <path d="M46 100 C40 56 70 34 100 34 C130 34 160 56 154 100 L160 176 C146 190 54 190 40 176 Z" fill="@L.Hair" />
                @foreach (var (x, y) in CurlyEdge)
                {
                    <circle cx="@x" cy="@y" r="13" fill="@L.Hair" />
                }
                break;
            case HairStyle.Ponytail:
                <path d="M142 64 C182 52 196 100 176 142 C178 116 168 96 150 88 Z" fill="@L.Hair" />
                <ellipse cx="148" cy="70" rx="8" ry="6" fill="@L.AccessoryColor" />
                break;
            case HairStyle.Pigtails:
                <ellipse cx="34" cy="120" rx="15" ry="26" fill="@L.Hair" transform="rotate(18 34 120)" />
                <ellipse cx="166" cy="120" rx="15" ry="26" fill="@L.Hair" transform="rotate(-18 166 120)" />
                <circle cx="44" cy="96" r="6" fill="#e03131" />
                <circle cx="156" cy="96" r="6" fill="#e03131" />
                break;
            case HairStyle.Braid:
                @for (var i = 0; i < 5; i++)
                {
                    <ellipse cx="@(146 + i * 3)" cy="@(118 + i * 16)" rx="11" ry="10" fill="@(i % 2 == 0 ? L.Hair : HairDark)" />
                }
                <path d="M146 196 l6 14 l6 -14 z" fill="@L.Hair" />
                <circle cx="158" cy="194" r="5" fill="#d6336c" />
                break;
        }
    };

    private RenderFragment FrontHair => __builder =>
    {
        switch (L.Style)
        {
            case HairStyle.Short:
                <path d="M48 102 C44 56 74 38 100 38 C128 38 157 56 152 102 C147 84 136 72 122 68 C112 77 92 80 78 72 C66 78 54 88 48 102 Z" fill="@L.Hair" />
                break;
            case HairStyle.Spiky:
                <path d="M49 100 L44 62 L60 66 L62 40 L80 52 L92 28 L106 48 L122 30 L128 54 L146 44 L144 68 L158 64 L151 100 C142 82 122 74 100 74 C80 74 60 82 49 100 Z" fill="@L.Hair" />
                break;
            case HairStyle.Curly:
                <path d="M48 98 C46 58 72 40 100 40 C128 40 154 58 152 98 C140 80 120 74 100 74 C80 74 60 80 48 98 Z" fill="@L.Hair" />
                @foreach (var (x, y) in CurlyTop)
                {
                    <circle cx="@x" cy="@y" r="12" fill="@L.Hair" />
                }
                break;
            case HairStyle.CurlyLong:
                <path d="@SideFringe" fill="@L.Hair" />
                @foreach (var (x, y) in CurlyTop)
                {
                    <circle cx="@x" cy="@y" r="11" fill="@L.Hair" />
                }
                break;
            default:
                <path d="@SideFringe" fill="@L.Hair" />
                break;
        }
    };

    private RenderFragment Extras => __builder =>
    {
        var c = L.AccessoryColor;
        switch (L.Accessory)
        {
            case Accessory.Glasses:
                <g fill="rgba(255,255,255,.18)" stroke="@c" stroke-width="3.5">
                    <circle cx="80" cy="108" r="14" />
                    <circle cx="120" cy="108" r="14" />
                </g>
                <path d="M94 107 Q100 102 106 107 M66 106 L50 102 M134 106 L150 102" fill="none" stroke="@c" stroke-width="3.5" stroke-linecap="round" />
                break;
            case Accessory.Bow:
                <g transform="rotate(-18 128 50)">
                    <path d="M128 50 L106 38 Q102 50 106 62 Z" fill="@c" />
                    <path d="M128 50 L150 38 Q154 50 150 62 Z" fill="@c" />
                    <circle cx="128" cy="50" r="6" fill="@Mix(c, "#000000", 0.2)" />
                </g>
                break;
            case Accessory.Beanie:
                <path d="M44 88 C42 34 158 34 156 88 Z" fill="@c" />
                <rect x="40" y="78" width="120" height="20" rx="10" fill="@Mix(c, "#ffffff", 0.3)" />
                @for (var x = 52; x < 156; x += 12)
                {
                    <rect x="@x" y="80" width="4" height="16" rx="2" fill="@Mix(c, "#000000", 0.12)" />
                }
                <circle cx="100" cy="34" r="13" fill="#fff" />
                break;
            case Accessory.Cap:
                <path d="M48 84 C46 32 154 32 152 84 Z" fill="@c" />
                <path d="M44 82 Q100 70 156 82 Q148 98 100 94 Q52 98 44 82 Z" fill="@Mix(c, "#000000", 0.2)" />
                <circle cx="100" cy="40" r="5" fill="@Mix(c, "#ffffff", 0.4)" />
                <path d="M84 60 Q100 52 116 60" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
                break;
            case Accessory.Headband:
                <path d="M50 84 Q100 22 150 84" fill="none" stroke="@c" stroke-width="10" stroke-linecap="round" />
                break;
            case Accessory.HairClip:
                <rect x="118" y="60" width="26" height="9" rx="4.5" fill="@c" transform="rotate(-20 131 64)" />
                break;
            case Accessory.Flower:
                @Flower(134, 60, 1.0, c, "#fcc419")
                break;
            case Accessory.FlowerCrown:
                <path d="M52 76 Q100 30 148 76" fill="none" stroke="#2f9e44" stroke-width="5" />
                @Flower(56, 74, 0.75, "#e03131", "#fcc419")
                @Flower(74, 56, 0.8, "#fcc419", "#e8590c")
                @Flower(100, 48, 0.9, "#1c7ed6", "#fcc419")
                @Flower(126, 56, 0.8, "#e03131", "#fcc419")
                @Flower(144, 74, 0.75, "#ae3ec9", "#fcc419")
                break;
        }
    };

    private static RenderFragment Flower(double x, double y, double scale, string petal, string middle) => __builder =>
    {
        <g transform="translate(@F(x) @F(y)) scale(@F(scale))">
            @for (var i = 0; i < 5; i++)
            {
                <circle cx="@F(9 * Math.Cos(i * 2 * Math.PI / 5))" cy="@F(9 * Math.Sin(i * 2 * Math.PI / 5))" r="7" fill="@petal" />
            }
            <circle r="5" fill="@middle" />
        </g>
    };

    // Curls along the top of the head (an arc around the head's centre).
    private static readonly (string, string)[] CurlyTop = Arc(100, 100, 54, 200, 340, 9);
    // Curls down both sides, for long curly hair.
    private static readonly (string, string)[] CurlyEdge =
        [.. Arc(100, 110, 62, 120, 190, 6), .. Arc(100, 110, 62, 350, 420, 6)];

    private static (string, string)[] Arc(double cx, double cy, double r, double from, double to, int n) =>
        Enumerable.Range(0, n)
            .Select(i => (from + (to - from) * i / (n - 1)) * Math.PI / 180)
            .Select(a => (F(cx + r * Math.Cos(a)), F(cy + r * Math.Sin(a))))
            .ToArray();

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Mixes two #rrggbb colours: t = 0 gives a, t = 1 gives b.</summary>
    private static string Mix(string a, string b, double t)
    {
        static (int, int, int) Rgb(string h) =>
            (Convert.ToInt32(h[1..3], 16), Convert.ToInt32(h[3..5], 16), Convert.ToInt32(h[5..7], 16));
        var (r1, g1, b1) = Rgb(a);
        var (r2, g2, b2) = Rgb(b);
        int M(int x, int y) => (int)Math.Round(x + (y - x) * t);
        return $"#{M(r1, r2):x2}{M(g1, g2):x2}{M(b1, b2):x2}";
    }
}
